fetch('/api/analyze', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ chunk: 'اليوم هنتكلم عن المعادلات التفاضلية من الدرجة الأولى وطرق حلها' })
})
.then(r => r.json())
.then(d => console.log('✅ Success:', d))
.catch(e => console.error('❌ Error:', e));